    "@tailwindcss/vite": "^4.3.0",
    "@tinacms/cli": "^2.4.4",
    "@types/mdx": "^2.0.14",
    "@types/node": "^22.19.20",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "cross-env": "^10.1.0",
    "prettier": "^3.8.4",
    "prettier-plugin-tailwindcss": "^0.7.4",
    "tailwindcss": "^4.2.1",
